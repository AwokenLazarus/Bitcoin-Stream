#!/bin/bash
# `start-cli s9pk pack` pipes each image's root filesystem (a tar) into `tar2sqfs -q DEST` (squashfs-tools-ng).
# This host has squashfs-tools 4.6 instead, whose mksquashfs reads a tar on stdin: same result, a squashfs of
# the tar with its owners and modes kept, the root directory root-owned 0755. Only `tar2sqfs [-q] DEST`.
set -euo pipefail
args=()
for a in "$@"; do [ "$a" = "-q" ] || args+=("$a"); done
[ ${#args[@]} -eq 1 ] || { echo "tar2sqfs shim: usage: tar2sqfs [-q] DEST" >&2; exit 2; }
exec mksquashfs - "${args[0]}" -tar -quiet -noappend -comp gzip -no-progress -root-uid 0 -root-gid 0 -root-mode 0755
